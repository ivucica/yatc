module(
    name = "yatc",
    version = "0.0.0",
)

bazel_dep(name = "glict", version = "0.0.0")
bazel_dep(name = "libsdlgfx", version = "0.0.0")
bazel_dep(name = "rules_libsdl12", version = "0.0.0")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_tibia", version = "0.0.0")

local_path_override(
    module_name = "glict",
    path = "vendor/github.com/ivucica/glict",
)
local_path_override(
    module_name = "libsdlgfx",
    path = "third_party/SDL_gfx-2.0.24",
)
local_path_override(
    module_name = "rules_libsdl12",
    path = "vendor/github.com/ivucica/rules_libsdl12",
)
local_path_override(
    module_name = "rules_tibia",
    path = "vendor/github.com/ivucica/rules_tibia",
)

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

http_archive(
    name = "hedron_compile_commands",
    url = "https://github.com/hedronvision/bazel-compile-commands-extractor/archive/ed994039a951b736091776d677f324b3903ef939.tar.gz",
    strip_prefix = "bazel-compile-commands-extractor-ed994039a951b736091776d677f324b3903ef939",
    sha256 = "085bde6c5212c8c1603595341ffe7133108034808d8c819f8978b2b303afc9e7",
)

yatc_local = use_extension("//:module_extensions.bzl", "yatc_local_repositories")
use_repo(
    yatc_local,
    "bazelregistry_sdl2",
    "tommath",
)

rules_tibia = use_extension("@rules_tibia//:tibia_data.bzl", "tibia_data_extension")
use_repo(
    rules_tibia,
    "tibia790",
    "tibia791",
    "tibia792",
    "tibia800",
    "tibia810",
    "tibia811",
