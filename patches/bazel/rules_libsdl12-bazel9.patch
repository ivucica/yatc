+def _xcb_repository_rule_impl(ctx):
+    ctx.file(
+        "BUILD.bazel",
+        "exports_files(glob(['xcb/**']), visibility = ['//visibility:public'])\n",
+    )
+
+    ctx.symlink(ctx.path(ctx.attr.include_path).get_child("xcb"), "xcb")
+
+
+xcb_repository_rule = repository_rule(
+    implementation = _xcb_repository_rule_impl,
+    attrs = {
+        "include_path": attr.string(default = "/usr/include"),
+    },
+)
