diff --git a/libsdl12.bzl b/libsdl12.bzl
index 4da5b99..8e53e13 100644
--- a/libsdl12.bzl
+++ b/libsdl12.bzl
@@ -44,3 +44,13 @@ def libsdl12_repositories():
 #    However, the repos still need to exist even if only referenced in select()s in actual build targets (e.g. to link with libglu1-mesa-dev).
 #
 #    Let's instead do this in x11-helper.bzl for now.
+
+
+def _libsdl12_extension_impl(module_ctx):
+    del module_ctx
+    libsdl12_repositories()
+
+
+libsdl12_extension = module_extension(
+    implementation = _libsdl12_extension_impl,
+)
